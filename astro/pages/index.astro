---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Skills from "../components/Skills.astro";
import "../styles/pages/home.css";
import { withBase } from "../utils/withBase";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout>
  <div class="homeContainer">
    <main>
      <section
        id="aboutMeContainer"
        class="hero"
        aria-labelledby="hero-title"
      >
        <div id="aboutMe" class="aboutMeText">
          <p class="heroEyebrow">
            <span aria-hidden="true"></span> Available for opportunities
          </p>
          <h1 id="hero-title">Jack Lockhart</h1>
          <p class="heroRole">Computer Science <span>/</span> Cybersecurity</p>
          <p class="aboutMeParagraph">
            I am studying computer science and cyber security at the University
            of Alabama and plan on getting my MBA afterwards. I am interested in
            cloud computing, cyber security, and AI systems. I have experience
            with a variety of programming languages and security technologies. I
            completed my Network+ and Security+ certifications and am working
            towards my CCNA certification.
          </p>
          <div class="heroCtas">
            <a href={withBase("/projects")} class="button button--primary">
              View projects <span aria-hidden="true">→</span>
            </a>
            <a href={withBase("/resume")} class="button button--outline">
              Résumé
            </a>
          </div>
          <ul class="heroDetails" aria-label="Professional focus">
            <li>Security</li>
            <li>Cloud</li>
            <li>AI systems</li>
          </ul>
        </div>
        <div id="headshotSection">
          <div class="portraitFrame">
            <img
              src={withBase("/assets/profile/myPic.jpg")}
              alt="Jack Lockhart"
              class="myPic"
            />
          </div>
        </div>
      </section>
      <section class="homeProjectsSection" aria-labelledby="projects-title">
        <div class="homeProjectsHeader">
          <h2 id="projects-title">Featured projects</h2>
          <a href={withBase("/projects")} class="seeAllProjectsLink"
            >All projects <span aria-hidden="true">→</span></a
          >
        </div>
        <div class="homeProjectGrid">
          {
            projects.map((project) => (
              <ProjectCard
                slug={project.id}
                name={project.data.name}
                image={project.data.image}
                imageAlt={project.data.imageAlt}
                skills={project.data.skills}
                description={project.data.description}
                siteUrl={project.data.siteUrl}
              />
            ))
          }
        </div>
      </section>
      <Skills />
    </main>
  </div>

</BaseLayout>
