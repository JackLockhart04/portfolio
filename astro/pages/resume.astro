---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/resume.css";
import { withBase } from "../utils/withBase";
---

<BaseLayout title="Résumé | Jack Lockhart">
  <div class="resumeContainer">
    <div class="resumeHeader">
      <a
        href={withBase("/assets/resume/Jack_Lockhart_Resume.pdf")}
        download
        class="downloadButton"
      >
        Download Resume
      </a>
    </div>
    <div class="resumeContent">
      <img
        src={withBase("/assets/resume/Jack_Lockhart_Resume.png")}
        alt="Resume"
        class="resumeImage"
      />
    </div>
  </div>
</BaseLayout>
