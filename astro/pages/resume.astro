---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/resume.css";
import { withBase } from "../utils/withBase";

const resumeUrl = withBase("/assets/resume/Jack_Lockhart_Resume.pdf");
const resumeImageUrl = withBase(
  "/assets/resume/Jack_Lockhart_Resume.generated.png",
);
---

<BaseLayout title="Résumé | Jack Lockhart">
  <div class="resumeContainer">
    <div class="resumeHeader">
      <a
        href={resumeUrl}
        download
        class="button button--primary"
      >
        Download Resume
      </a>
    </div>
    <div class="resumeContent">
      <a href={resumeUrl} aria-label="Open Jack Lockhart's résumé as a PDF">
        <img
          src={resumeImageUrl}
          alt="Jack Lockhart résumé"
          class="resumeImage"
        />
      </a>
    </div>
  </div>
</BaseLayout>
