---
import "../styles/components/contact-footer.css";
import { contactMethods } from "../data/site";
---

<footer class="contactFooter">
  <h2 class="contactFooterHeader">Contact Information</h2>
  {
    contactMethods.map((method) => (
      <div class="contactFooterItem">
        <h3>{method.label}</h3>
        <p>
          {method.href ? (
            <a
              href={method.href}
              target={method.external ? "_blank" : undefined}
              rel={method.external ? "noopener noreferrer" : undefined}
            >
              {method.value}
            </a>
          ) : (
            method.value
          )}
        </p>
      </div>
    ))
  }
</footer>
