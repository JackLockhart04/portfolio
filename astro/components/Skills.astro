---
import "../styles/components/skills.css";
import { withBase } from "../utils/withBase";
---

<div class="homeSkillsSection">
  <div class="homeSkillsHeading">
    <p class="sectionLabel">02 // CAPABILITIES</p>
    <h2 class="homeSkillsHeader">Technical toolkit</h2>
  </div>
  <div class="homeSkillsGroupContainer">
    <div class="homeSkillsGroup">
      <div class="homeSkillsGroupHeader">
        <img
          src={withBase("/logos/certifications-icon.png")}
          alt="Certifications"
          class="homeSkillsGroupIcon"
        />
        <h3>
          <a href={withBase("/certifications")} class="homeSkillsGroupLink">
            Certifications
          </a>
        </h3>
      </div>
      <div class="homeSkillsList">
        <span>CompTIA Security+ (SY0-701)</span>
        <span>CompTIA Network+ (N10-009)</span>
      </div>
    </div>
    <div class="homeSkillsGroup">
      <div class="homeSkillsGroupHeader">
        <img
          src={withBase("/logos/backend-icon.png")}
          alt="Backend"
          class="homeSkillsGroupIcon"
        />
        <h3>Development</h3>
      </div>
      <div class="homeSkillsList">
        <span>Python</span>
        <span>Java</span>
        <span>C++</span>
        <span>Rust</span>
        <span>JavaScript</span>
        <span>TypeScript</span>
        <span>React</span>
      </div>
    </div>
    <div class="homeSkillsGroup">
      <div class="homeSkillsGroupHeader">
        <img
          src={withBase("/logos/other-icon.png")}
          alt="Other Technologies"
          class="homeSkillsGroupIcon"
        />
        <h3>Other Technologies</h3>
      </div>
      <div class="homeSkillsList">
        <span>Linux</span>
        <span>Cryptography</span>
        <span>Networks</span>
        <span>Git</span>
        <span>Docker</span>
        <span>SQL</span>
        <span>AI Models</span>
        <span>AWS (Lambda, CloudFront, IAM)</span>
        <span>Microsoft Azure</span>
        <span>Oracle Cloud</span>
      </div>
    </div>
  </div>
</div>
