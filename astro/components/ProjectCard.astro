---
import "../styles/components/project-card.css";
import { withBase } from "../utils/withBase";

interface Props {
  slug: string;
  name: string;
  image: string;
  imageAlt: string;
  skills: string[];
  description: string;
  siteUrl?: string;
}

const { slug, name, image, imageAlt, skills, description, siteUrl } = Astro.props;
const projectLink = withBase(`/projects/${slug}`);
---

<div class="projectCard">
  <div class="projectCardImageSection">
    <img src={withBase(image)} alt={imageAlt} class="projectCardImage" />
  </div>
  <div class="projectCardSkillsSection">
    <p class="projectCardSkillsText">{skills.join(", ")}</p>
  </div>
  <div class="projectCardDescriptionSection">
    <h2 class="projectCardName">{name}</h2>
    <p class="projectCardDescription">{description}</p>
  </div>
  <div class="projectCardLinkSection">
    {
      siteUrl && (
        <a
          href={siteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="projectCardSiteLink"
        >
          Visit live site <span aria-hidden="true">↗</span>
        </a>
      )
    }
    <a href={projectLink} class="button button--primary projectCardButton">
      View project
    </a>
  </div>
</div>
